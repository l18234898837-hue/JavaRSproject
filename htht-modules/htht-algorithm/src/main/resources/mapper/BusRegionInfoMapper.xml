<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.htht.algorithm.data.mapper.BusRegionInfoMapper">

    <select id="getGeometryByCode" resultType="java.lang.String">
        SELECT ST_AsText(geometry) as geometry from bus_region_info where code=#{code}
    </select>
</mapper>
