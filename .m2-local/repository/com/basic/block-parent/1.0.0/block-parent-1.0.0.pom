<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.4.5</version>
    </parent>

    <groupId>com.basic</groupId>
    <artifactId>block-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>basic-common</module>
        <module>basic-netcdf2</module>
        <module>basic-resultcreator</module>
        <module>basic-tile</module>
    </modules>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <docker.plugin.version>0.3.258</docker.plugin.version>
        <spring-boot-admin.version>1.4.5</spring-boot-admin.version>
        <druid.version>1.0.18</druid.version>
        <docker.image.prefix>server-admin</docker.image.prefix>
        <maven-source-plugin.version>3.2.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.1.1</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>1.6</maven-gpg-plugin.version>
        <maven-war-plugin.version>3.2.3</maven-war-plugin.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>12</java.version>
        <drools.version>7.1.0.Final</drools.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.7</maven.compiler.source>
        <maven.compiler.target>1.7</maven.compiler.target>
        <mybatis-plus-boot-starter.version>3.4.1</mybatis-plus-boot-starter.version>
        <mybatisplus.version>2.1.8</mybatisplus.version>
        <HikariCP.version>2.4.13</HikariCP.version>
        <fastjson.version>1.2.39</fastjson.version>
        <mysql-connector.version>5.1.38</mysql-connector.version>
        <activiti.version>5.22.0</activiti.version>
        <swagger2.version>3.0.0</swagger2.version>
        <quartz.version>2.3.2</quartz.version>
        <velocity.version>1.7</velocity.version>
        <velocity-tools.version>2.0</velocity-tools.version>
        <jsoup.version>1.9.2</jsoup.version>
        <restassured.version>2.9.0</restassured.version>
        <restassured.version>1.7</restassured.version>
        <druid.version>1.0.28</druid.version>
        <commons-lang3.version>3.6</commons-lang3.version>
        <commons-configuration.version>1.10</commons-configuration.version>
        <commons-io.version>2.5</commons-io.version>
        <shiro.version>1.3.2</shiro.version>
        <thymeleaf-extras-shiro.version>1.2.1</thymeleaf-extras-shiro.version>
        <fastjson.version>1.2.31</fastjson.version>
        <slf4j.version>1.7.2</slf4j.version>
        <!--<jedis.version>2.7.3</jedis.version>-->
        <redisson.version>3.5.6</redisson.version>
        <spring-data-redis.version>2.0.5.RELEASE</spring-data-redis.version>
        <cxf.version>3.2.1</cxf.version>
        <jackson-databind-version>2.10.1</jackson-databind-version>
        <hibernate-validator.version>6.0.7.Final</hibernate-validator.version>
        <javax.validation.version>2.0.1.Final</javax.validation.version>
        <javax.el.version>3.0.1-b04</javax.el.version>
        <glassfish.web.version>2.2.6</glassfish.web.version>
        <basic-common.version>1.0.0</basic-common.version>

        <spring-boot.version>2.7.15</spring-boot.version>
        <spring.version>5.3.30</spring.version>
        <netty.version>4.1.111.Final</netty.version>
        <lombok.version>1.18.36</lombok.version>
        <jackson.version>2.18.3</jackson.version>
        <mybatis-plus.version>3.4.3</mybatis-plus.version>
        <okhttp.vserion>4.12.0</okhttp.vserion>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target/classes</outputDirectory>
                            <includeEmptyDirs>true</includeEmptyDirs>
                            <resources>
                                <resource>
                                    <directory>src/main/resource</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>org.owasp</groupId>-->
<!--                <artifactId>dependency-check-maven</artifactId>-->
<!--                <version>7.1.1</version>-->
<!--                <configuration>-->
<!--                    <dataDirectory>F:\server\dependency-check\data</dataDirectory>-->
<!--                    <autoUpdate>false</autoUpdate>-->
<!--                    <skipSystemScope>true</skipSystemScope>-->
<!--                    <skipRuntimeScope>true</skipRuntimeScope>-->
<!--                    <skipProvidedScope>true</skipProvidedScope>-->
<!--                </configuration>-->
<!--                <executions>-->
<!--                    <execution>-->
<!--                        <goals>-->
<!--                            <goal>check</goal>-->
<!--                        </goals>-->
<!--                    </execution>-->
<!--                </executions>-->
<!--            </plugin>-->
        </plugins>

        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                </includes>
                <!-- 是否替换资源中的属性-->
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <!--
                    <includes> <include>**/*.properties</include>
                    <include>**/*.xml</include> </includes> <filtering>true</filtering>
                -->
            </resource>
        </resources>
    </build>


    <distributionManagement>
        <!--正式版本-->
        <repository>
            <!-- nexus服务器中用户名：在settings.xml中<server>的id-->
            <id>nexusmy</id>
            <!-- 这个名称自己定义 -->
            <name>Release repository</name>
            <url>http://192.168.2.118:8081/repository/maven-releases/</url>
        </repository>
        <!--快照-->
        <snapshotRepository>
            <id>nexusmy</id>
            <name>Snapshots repository</name>
            <url>http://192.168.2.118:8081/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>